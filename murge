const SHEETS = {
  users: "Sammelan_Users",
  registrations: "Sammelan_Registrations",
  donations: "Sammelan_Donations",
  other: "Sammelan_OtherIncome",
  expenses: "Sammelan_Expenses"
};

function doGet(e) {
  try {
    if (!e || !e.parameter || !e.parameter.payload) {
      return ContentService.createTextOutput("SPR Sammelan API चालू है");
    }

    const req = JSON.parse(e.parameter.payload);
    const result = handleRequest(req);
    const callback = String(e.parameter.callback || "");

    if (callback && /^[a-zA-Z_$][0-9a-zA-Z_$]*$/.test(callback)) {
      return ContentService.createTextOutput(
        callback + "(" + JSON.stringify(result) + ");"
      ).setMimeType(ContentService.MimeType.JAVASCRIPT);
    }

    return jsonOutput(result);
  } catch (err) {
    return jsonOutput({success:false, message:String(err.message || err)});
  }
}

function doPost(e) {
  try {
    const req = JSON.parse(e.postData.contents);
    return jsonOutput(handleRequest(req));
  } catch (err) {
    return jsonOutput({success:false, message:String(err.message || err)});
  }
}

function jsonOutput(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

function getSS() {
  return SpreadsheetApp.getActiveSpreadsheet();
}

function getSheet(name, headers) {
  const ss = getSS();
  let sh = ss.getSheetByName(name);

  if (!sh) {
    sh = ss.insertSheet(name);
    sh.appendRow(headers);
    sh.setFrozenRows(1);
  }
  return sh;
}

function hashPassword(password) {
  const bytes = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    String(password),
    Utilities.Charset.UTF_8
  );
  return bytes.map(b => {
    const v = (b < 0 ? b + 256 : b).toString(16);
    return v.length === 1 ? "0" + v : v;
  }).join("");
}

function userSheet() {
  return getSheet(SHEETS.users,
    ["Username","PasswordHash","Name","Role","Token","Mobile"]);
}

function dataSheet(type) {
  const headers = ["ID","Date","Receipt","Amount","Operator","DataJSON"];
  return getSheet(SHEETS[type], headers);
}

function ensureAdmin() {
  const sh = userSheet();

  if (sh.getLastRow() <= 1) {
    sh.appendRow([
      "admin",
      hashPassword("Admin@123"),
      "Admin",
      "admin",
      "",
      ""
    ]);
  }
}

function findUserByToken(token) {
  if (!token) return null;

  const sh = userSheet();
  const rows = sh.getDataRange().getValues();

  for (let i = 1; i < rows.length; i++) {
    if (String(rows[i][4]) === String(token)) {
      return {
        username: rows[i][0],
        name: rows[i][2],
        role: rows[i][3],
        mobile: rows[i][5]
      };
    }
  }
  return null;
}

function requireUser(req) {
  const user = findUserByToken(req.token);
  if (!user) throw new Error("लॉगिन समाप्त हो गया है। दोबारा लॉगिन करें।");
  return user;
}

function handleRequest(req) {
  ensureAdmin();

  switch (req.action) {
    case "login": return login(req);
    case "dashboard": return dashboard(req);
    case "getData": return getAllData(req);
    case "addOp": return addOperator(req);
    case "saveReg": return saveRecord(req, "registrations", "R");
    case "saveDon": return saveRecord(req, "donations", "D");
    case "saveOther": return saveRecord(req, "other", "O");
    case "saveExp": return saveRecord(req, "expenses", "E");
    case "deleteFinance": return deleteFinance(req);
    case "public": return publicData();
    default:
      return {success:false, message:"गलत Action"};
  }
}

function login(req) {
  const sh = userSheet();
  const rows = sh.getDataRange().getValues();
  const username = String(req.username || "").trim().toLowerCase();
  const password = hashPassword(req.password || "");

  for (let i = 1; i < rows.length; i++) {
    if (
      String(rows[i][0]).trim().toLowerCase() === username &&
      String(rows[i][1]) === password
    ) {
      const token = Utilities.getUuid();
      sh.getRange(i + 1, 5).setValue(token);

      return {
        success:true,
        token:token,
        id:String(rows[i][0]),
        name:String(rows[i][2]),
        role:String(rows[i][3])
      };
    }
  }

  return {success:false, message:"यूजर ID या पासवर्ड गलत है।"};
}

function addOperator(req) {
  const user = requireUser(req);
  if (user.role !== "admin") {
    throw new Error("ऑपरेटर केवल Admin बना सकता है।");
  }

  const d = req.data || {};
  const id = String(d.id || "").trim();
  const password = String(d.password || "");
  const name = String(d.name || "").trim();
  const mobile = String(d.mobile || "").trim();

  if (!id || !password || !name) {
    throw new Error("नाम, ID और पासवर्ड भरें।");
  }
  if (!/^[0-9]{10}$/.test(mobile)) {
    throw new Error("मोबाइल नंबर 10 अंकों का होना चाहिए।");
  }

  const sh = userSheet();
  const rows = sh.getDataRange().getValues();

  for (let i = 1; i < rows.length; i++) {
    if (String(rows[i][0]).toLowerCase() === id.toLowerCase()) {
      throw new Error("यह Operator ID पहले से मौजूद है।");
    }
  }

  sh.appendRow([
    id, hashPassword(password), name, "operator", "", mobile
  ]);

  return {success:true, message:"ऑपरेटर सफलतापूर्वक जोड़ दिया गया।"};
}

function makeReceipt(prefix, sh) {
  return prefix + String(Math.max(1, sh.getLastRow())).padStart(5, "0");
}

function saveRecord(req, type, prefix) {
  const user = requireUser(req);
  const d = req.data || {};

  if (type === "registrations" && user.role !== "operator") {
    throw new Error("पंजीयन केवल Operator दर्ज कर सकता है।");
  }
  if (type !== "registrations" && user.role !== "admin") {
    throw new Error("यह सुविधा केवल Admin के लिए है।");
  }

  if (type === "registrations") {
    if (!d.type || !d.regNo || !d.name || !d.mobile || !d.village) {
      throw new Error("पंजीयन की जरूरी जानकारी भरें।");
    }
    if (!/^[0-9]{10}$/.test(String(d.mobile))) {
      throw new Error("मोबाइल नंबर 10 अंकों का होना चाहिए।");
    }
  } else {
    if (!d.name || !d.date || Number(d.amount) <= 0) {
      throw new Error("नाम, तारीख और सही राशि भरें।");
    }
  }

  const sh = dataSheet(type);
  const id = Utilities.getUuid();
  const receipt = makeReceipt(prefix, sh);
  const amount = Number(d.amount) || 0;
  const date = String(d.date || Utilities.formatDate(
    new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd"
  ));

  const record = Object.assign({}, d, {
    id:id,
    receipt:receipt,
    date:date,
    amount:amount,
    operatorId:user.username,
    operatorName:user.name
  });

  sh.appendRow([
    id,
    date,
    receipt,
    amount,
    user.username,
    JSON.stringify(record)
  ]);

  return {success:true, receipt:receipt, message:"रिकॉर्ड सुरक्षित हो गया।"};
}

function readRecords(type) {
  const sh = dataSheet(type);
  const rows = sh.getDataRange().getValues();
  const result = [];

  for (let i = 1; i < rows.length; i++) {
    try {
      result.push(JSON.parse(rows[i][5]));
    } catch (e) {}
  }
  return result;
}

function getAllData(req) {
  const user = requireUser(req);

  const registrations = readRecords("registrations");
  const operators = [];
  const users = userSheet().getDataRange().getValues();

  if (user.role === "admin") {
    for (let i = 1; i < users.length; i++) {
      if (String(users[i][3]) === "operator") {
        operators.push({
          id:users[i][0],
          name:users[i][2],
          mobile:users[i][5],
          role:"operator"
        });
      }
    }
  }

  return {
    success:true,
    registrations: user.role === "admin"
      ? registrations
      : registrations.filter(r => r.operatorId === user.username),
    operators:operators,
    donations:user.role === "admin" ? readRecords("donations") : [],
    other:user.role === "admin" ? readRecords("other") : [],
    expenses:user.role === "admin" ? readRecords("expenses") : []
  };
}

function dashboard(req) {
  const user = requireUser(req);
  const regs = readRecords("registrations");
  const mine = user.role === "admin"
    ? regs
    : regs.filter(r => r.operatorId === user.username);

  return {
    success:true,
    total:mine.length,
    groom:mine.filter(r => r.type === "वर").length,
    bride:mine.filter(r => r.type === "वधु").length
  };
}

function deleteFinance(req) {
  const user = requireUser(req);
  if (user.role !== "admin") throw new Error("केवल Admin हटा सकता है।");

  const type = String(req.data && req.data.type || "");
  const id = String(req.data && req.data.id || "");

  if (!["donations","other","expenses"].includes(type)) {
    throw new Error("गलत रिकॉर्ड प्रकार।");
  }

  const sh = dataSheet(type);
  const rows = sh.getDataRange().getValues();

  for (let i = rows.length - 1; i >= 1; i--) {
    if (String(rows[i][0]) === id) {
      sh.deleteRow(i + 1);
      return {success:true, message:"रिकॉर्ड हटा दिया गया।"};
    }
  }

  return {success:false, message:"रिकॉर्ड नहीं मिला।"};
}

function publicData() {
  const regs = readRecords("registrations");
  const villages = {};

  regs.forEach(r => {
    const name = String(r.village || "").trim();
    if (!name) return;

    const key = name.toLowerCase();
    if (!villages[key]) {
      villages[key] = {name:name, groom:0, bride:0};
    }

    if (r.type === "वर") villages[key].groom++;
    if (r.type === "वधु") villages[key].bride++;
  });

  return {
    success:true,
    total:regs.length,
    villages:Object.values(villages).sort((a,b) =>
      a.name.localeCompare(b.name, "hi")
    )
  };
}
