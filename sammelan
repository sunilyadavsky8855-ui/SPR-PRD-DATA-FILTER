<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>सम्मेलन पंजीयन</title>

<style>
body {
    font-family: Arial, sans-serif;
    background: #f2f5f9;
    padding: 15px;
}

.container {
    max-width: 550px;
    margin: auto;
    background: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 2px 10px #ccc;
}

h2 {
    text-align: center;
    color: #174b80;
}

label {
    display: block;
    margin-top: 15px;
    font-weight: bold;
}

input {
    width: 100%;
    padding: 11px;
    margin-top: 5px;
    box-sizing: border-box;
    border: 1px solid #bbb;
    border-radius: 5px;
}

button {
    width: 100%;
    padding: 12px;
    margin-top: 20px;
    background: #1769aa;
    color: white;
    border: none;
    border-radius: 5px;
    font-size: 17px;
    cursor: pointer;
}
</style>
</head>

<body>

<div class="container">

<h2>सम्मेलन पंजीयन फॉर्म</h2>

<form id="registrationForm">

<label>पंजीयन क्रमांक</label>
<input type="text" id="regNo" required>

<label>व्यक्ति का नाम</label>
<input type="text" id="name" required>

<label>मोबाइल नंबर</label>
<input type="tel" id="mobile"
pattern="[0-9]{10}"
maxlength="10" required>

<label>गाँव का नाम</label>
<input type="text" id="village" required>

<label>तहसील</label>
<input type="text" id="tehsil" required>

<label>जिला</label>
<input type="text" id="district" required>

<button type="submit">पंजीयन करें</button>

</form>

<p id="message"></p>

</div>

<script>
document.getElementById("registrationForm")
.addEventListener("submit", function(e) {
    e.preventDefault();

    alert("पंजीयन फॉर्म सफलतापूर्वक भरा गया है।");
});
</script>

</body>
</html>
